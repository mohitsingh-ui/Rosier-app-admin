{
  "expo": {
    "name": "Rosier",
    "slug": "rosier-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.rosierfoods.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#2A180C",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.rosierfoods.app"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "./plugins/withGoogleServices",
      "expo-router",
      "expo-image",
      "expo-web-browser",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FBEBD8",
          "image": "./assets/splash-icon.png",
          "imageWidth": 260
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Rosier uses your photos so you can set a profile picture.",
          "cameraPermission": "Rosier uses your camera so you can take a profile picture.",
          "microphonePermission": false
        }
      ],
      "./plugins/withPaymentApps",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#A56312",
          "defaultChannel": "rosier_default",
          "sounds": [
            "./assets/sounds/rosier_chime.wav",
            "./assets/sounds/rosier_bell.wav",
            "./assets/sounds/rosier_coin.wav",
            "./assets/sounds/rosier_soft.wav"
          ]
        }
      ]
    ],
    "scheme": "rosier",
    "experiments": {
      "typedRoutes": false,
      "baseUrl": "/preview-app"
    },
    "extra": {
      "apiUrl": "https://rosier-app-backend.onrender.com"
    }
  }
}
